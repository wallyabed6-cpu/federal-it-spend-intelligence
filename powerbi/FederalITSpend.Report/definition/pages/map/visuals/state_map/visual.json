{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "state_map",
  "position": {
    "x": 24,
    "y": 96,
    "z": 1,
    "height": 604,
    "width": 820,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "azureMap",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_state"
                    }
                  },
                  "Property": "state_name"
                }
              },
              "queryRef": "dim_state.state_name",
              "nativeQueryRef": "state_name",
              "active": true
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_awards"
                    }
                  },
                  "Property": "Total Obligations"
                }
              },
              "queryRef": "fact_awards.Total Obligations",
              "nativeQueryRef": "Total Obligations"
            }
          ]
        }
      }
    },
    "objects": {
      "bubbleLayer": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "filledMap": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "FillRule": {
                      "Input": {
                        "Measure": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "fact_awards"
                            }
                          },
                          "Property": "Total Obligations"
                        }
                      },
                      "FillRule": {
                        "linearGradient2": {
                          "min": {
                            "color": {
                              "Literal": {
                                "Value": "'#cde2fb'"
                              }
                            },
                            "value": {
                              "Literal": {
                                "Value": "0D"
                              }
                            }
                          },
                          "max": {
                            "color": {
                              "Literal": {
                                "Value": "'#104281'"
                              }
                            },
                            "value": {
                              "Literal": {
                                "Value": "10000000000D"
                              }
                            }
                          },
                          "nullColoringStrategy": {
                            "strategy": {
                              "Literal": {
                                "Value": "'asZero'"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Obligations by state, FY2022\u2013FY2026'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Darker = more dollars. Color scale tops out at $10bn so smaller states stay visible; VA, MD, DC and CA are above it.'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  },
  "filterConfig": {
    "filters": [
      {
        "name": "states_only",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_state"
              }
            },
            "Property": "state_type"
          }
        },
        "type": "Categorical",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "t",
              "Entity": "dim_state",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": {
                          "SourceRef": {
                            "Source": "t"
                          }
                        },
                        "Property": "state_type"
                      }
                    }
                  ],
                  "Values": [
                    [
                      {
                        "Literal": {
                          "Value": "'state'"
                        }
                      }
                    ],
                    [
                      {
                        "Literal": {
                          "Value": "'dc'"
                        }
                      }
                    ]
                  ]
                }
              }
            }
          ]
        },
        "howCreated": "User"
      }
    ]
  }
}