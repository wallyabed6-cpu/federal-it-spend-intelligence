table fact_awards
	lineageTag: 5e0f5c54-d4fb-48a9-8acf-630963f187ad

	/// net obligated dollars: new obligations minus deobligations.
	/// matches USAspending totals ($262.9B for the whole project).
	measure 'Total Obligations' = SUM ( fact_awards[obligation] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Spend
		lineageTag: 1c910376-2d87-454c-9b7a-d7e28f165d37

	/// same measure one year earlier. works at any date level (year, quarter, month)
	/// because dim_date is marked as the date table.
	measure 'Prior Year Obligations' = CALCULATE ( [Total Obligations], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Spend
		lineageTag: 2d42315c-9449-4c4e-a23c-e6a2150e2ed7

	/// year-over-year change. careful with FY2026 defense: Q4 is incomplete
	/// (DoD publication lag), so FY2026 vs FY2025 understates defense growth.
	measure 'YoY Growth %' = DIVIDE ( [Total Obligations] - [Prior Year Obligations], [Prior Year Obligations] )
		formatString: 0.0%
		displayFolder: Spend
		lineageTag: 0d6ecae1-edf3-4f65-babd-676cda30daea

	/// distinct awards (an award plus all its modifications counts once)
	measure 'Award Count' = DISTINCTCOUNT ( fact_awards[award_id] )
		formatString: #,0
		displayFolder: Spend
		lineageTag: 2f5d7e74-28d0-4152-84b5-0911e401be85

	/// a vendor's slice of the spend in the current filter (e.g. one agency).
	/// the denominator ignores the vendor filter, so each vendor row is divided by the agency total.
	measure 'Vendor Share of Agency Spend' =
			DIVIDE (
			    [Total Obligations],
			    CALCULATE ( [Total Obligations], REMOVEFILTERS ( dim_vendor ) )
			)
		formatString: 0.0%
		displayFolder: Concentration
		lineageTag: 28c5b4a3-bdfe-458c-bbf6-ffc5f3a0ff85

	/// herfindahl-hirschman index: sum of squared vendor market shares (in percent).
	/// 10,000 = one vendor gets everything. vendors with zero or negative net dollars
	/// are left out, same as sql/05_hhi_by_agency.sql, so the numbers match.
	measure HHI =
			VAR vendors =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_vendor[vendor_key] ), "@amt", [Total Obligations] ),
			        [@amt] > 0
			    )
			VAR total = SUMX ( vendors, [@amt] )
			RETURN
			    SUMX ( vendors, ( DIVIDE ( [@amt], total ) * 100 ) ^ 2 )
		formatString: #,0
		displayFolder: Concentration
		lineageTag: b5722601-f880-408e-9d91-54dcd21951a4

	/// HHI band from the 2023 DOJ/FTC merger guidelines
	measure 'HHI Band' =
			VAR h = [HHI]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( h ), BLANK (),
			        h > 1800, "Highly concentrated",
			        h >= 1000, "Moderately concentrated",
			        "Unconcentrated"
			    )
		displayFolder: Concentration
		lineageTag: cce51061-f628-44ea-8b02-2db4da100669

	/// share of spend held by the 4 biggest vendors (easier to say out loud than HHI)
	measure 'Top 4 Vendor Share' =
			VAR vendors =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_vendor[vendor_key] ), "@amt", [Total Obligations] ),
			        [@amt] > 0
			    )
			VAR total = SUMX ( vendors, [@amt] )
			VAR top4 = TOPN ( 4, vendors, [@amt], DESC )
			RETURN
			    DIVIDE ( SUMX ( top4, [@amt] ), total )
		formatString: 0.0%
		displayFolder: Concentration
		lineageTag: 67c1cdcd-63cd-4c8c-a4c8-23af0ee93e8a

	/// transactions flagged by the isolation forest (top ~1% most unusual)
	measure 'Anomaly Count' = CALCULATE ( COUNTROWS ( fact_awards ), fact_awards[is_anomaly] = 1 )
		formatString: #,0
		displayFolder: Risk
		lineageTag: e10a643b-b708-442e-9d87-4d9d703faff3

	/// dollars in flagged transactions
	measure 'Anomaly Dollars' = CALCULATE ( [Total Obligations], fact_awards[is_anomaly] = 1 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Risk
		lineageTag: 8a6990f8-b7af-4eda-aa29-60e8be4b5a73

	/// flagged rows as a share of the rows the model scored (actions adding $10K or more)
	measure 'Anomaly Rate' =
			DIVIDE (
			    [Anomaly Count],
			    CALCULATE ( COUNTROWS ( fact_awards ), fact_awards[obligation] >= 10000 )
			)
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: 5f4eaae2-df39-4d8b-ade4-81047bc662fb

